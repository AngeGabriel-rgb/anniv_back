// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum pour les rôles d'utilisateur
enum Role {
  ADMIN
  USER
}

model Admin {
    id              Int       @id @default(autoincrement()) // Identifiant unique
    nom             String    // Nom de l'administrateur
    prenom          String    // Prénom de l'administrateur
    email           String    @unique // E-mail unique pour l'administrateur
    password        String    // Mot de passe
    role            Role      // Rôle de l'administrateur
    emailConfirmed  Boolean   @default(false) // Indique si l'e-mail a été confirmé
    anniversaires   Anniversaire[] // Relation avec les anniversaires
}

model Participant {
  id            Int      @id @default(autoincrement())
  nom           String
  prenom        String
  email         String   @unique
  password      String
  code_unique   String?  // Assurez-vous que ce champ existe
  est_confirme  Boolean  // Vérifiez que ce champ est présent
  emailConfirmed Boolean?
  anniversaires  Anniversaire[]
}

model Anniversaire {
    id              Int          @id @default(autoincrement()) // Identifiant unique
    date            DateTime     // Date de l'anniversaire
    description     String?       // Description de l'anniversaire (optionnelle)
    participantId   Int          // Référence à l'identifiant du participant
    adminId         Int          // Référence à l'identifiant de l'administrateur
    participant     Participant   @relation(fields: [participantId], references: [id]) // Relation avec le modèle Participant
    admin           Admin         @relation(fields: [adminId], references: [id]) // Relation avec le modèle Admin
}

model User {
    id       Int    @id @default(autoincrement())
    email    String @unique
    password String
    role     Role   // Utilise l'énumération pour le rôle
    nom      String
}
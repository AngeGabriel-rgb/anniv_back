// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // Chemin vers votre fichier SQLite
}

model Admin {
    id       Int    @id @default(autoincrement())
    email    String @unique
    password String
    role     String
    nom      String // Assurez-vous que ce champ est bien défini
    emailConfirmed  Boolean    @default(false)
    anniversaires   Anniversaire[]
}

model Participant {
  id              Int        @id @default(autoincrement())
  nom             String
  prenom          String
  email           String     @unique
  password        String
  emailConfirmed  Boolean    @default(false)
  anniversaires   Anniversaire[]
}

model Anniversaire {
  id              Int        @id @default(autoincrement())
  date            DateTime
  description     String
  participantId   Int
  adminId         Int
  participant     Participant @relation(fields: [participantId], references: [id])
  admin           Admin       @relation(fields: [adminId], references: [id])
}

model User {
    id       Int    @id @default(autoincrement())
    email    String @unique
    password String
    role     String
    nom      String
}